#!/usr/bin/env python3
"""A stand-in for the GitHub CLI for the Rune app's parity drives: `auth token`, `auth status`,
`api graphql` and `api /notifications -i`, answered from github_fake.py. MEAT_PROXY_FAKE_GH=signed-out
fails every call as a signed-out gh does."""
import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from github_fake import NOW, VIEWER, graphql  # noqa: E402


def main(argv):
    if os.environ.get("MEAT_PROXY_FAKE_GH") == "signed-out":
        print("To get started with GitHub CLI, please run:  gh auth login", file=sys.stderr)
        return 4
    if argv[:2] == ["auth", "token"]:
        print("gho_fake_parity_token")
        return 0
    if argv[:2] == ["auth", "status"]:
        print(f"github.com\n  ✓ Logged in to github.com account {VIEWER} (fake)")
        return 0
    if argv[:1] == ["api"]:
        rest = [a for a in argv[1:] if a not in ("--hostname", "github.com")]
        if "graphql" in rest:
            field = next(a for a in rest if a.startswith("query="))
            print(json.dumps(graphql(field[len("query="):])))
            return 0
        if any(a.startswith("/notifications") for a in rest):
            stamp = NOW.strftime("%a, %d %b %Y %H:%M:%S GMT")
            sys.stdout.write(f"HTTP/2.0 200 OK\r\nLast-Modified: {stamp}\r\nX-Poll-Interval: 60\r\n\r\n[]")
            return 0
    print(f"fake gh: unsupported {' '.join(argv)}", file=sys.stderr)
    return 1


sys.exit(main(sys.argv[1:]))
