{
  "$schema": "../../../tools/exact/scripts/app.schema.json",
  "name": "meat-proxy",
  "short_name": "meat-proxy",
  "id": "co.anomaly.meat-proxy-exact",
  "start_url": "/",
  "display": "standalone",
  "app": {
    "id": "co.anomaly.meat-proxy-exact",
    "name": "meat-proxy"
  },
  "host": {
    "web": {}
  },
  "deploy": {
    "store": {
      "web": "0"
    }
  },
  "env": [
    "GITHUB_CLIENT_ID",
    "GITHUB_CLIENT_SECRET",
    "GITHUB_TOKEN_ORIGIN",
    {
      "name": "GITHUB_API",
      "launch": true
    },
    {
      "name": "MEAT_PROXY_TEST_TOKEN",
      "launch": true
    }
  ]
}