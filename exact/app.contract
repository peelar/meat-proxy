// meat-proxy: a pull request inbox. Screens: Connect GitHub (/setup), Set up your inbox (/setup/preferences),
// the inbox (/), the sample inbox (/sample) and Settings (/settings, the Mac's Settings window on ⌘,).
// app.ts answers every source; the rules are logic.ts's. Colours and controls are the platform's.
use OAuthSession, OAuthResult from "@exact/oauth"
use showNotification, notificationclick, NotificationEvent from "@exact/notifications"
use EmptyState from "exact:content"

shape Time
  epochAtZero: number
  utcOffset: number

shape Row
  id: string
  number: number
  title: string
  url: string
  author: string
  mine: bool
  avatar: string
  age: string
  status: string
  tone: string
  depth: number
  parent: number
  ciFailing: bool
  nudge: bool
  draft: bool

shape Group
  name: string
  count: number
  pinned: bool
  watched: bool
  canUp: bool
  canDown: bool
  rows: Row[]

shape Inbox
  state: string
  user: string
  reason: string
  total: number
  attention: number
  groups: Group[]

shape SetupRepo
  name: string
  watched: bool
  canUp: bool
  canDown: bool

shape RuleRow
  id: string
  name: string
  query: string
  enabled: bool

shape Reply
  ok: bool
  message: string

routes nav
  home "/"
    setup "/setup"
    prefs "/setup/preferences"
    sample "/sample"
    settings "/settings"

fn filterIds(): string[] = ["all", "action", "mine", "drafts", "theirs"]
fn filterLabel(f: string): string = f == "all" ? "All" : f == "action" ? "Action" : f == "mine" ? "Mine" : f == "drafts" ? "Drafts" : "Theirs"
fn toneColor(tone: string): string = tone == "accent" ? "-exact-system-green" : tone == "warning" ? "-exact-system-orange" : tone == "danger" ? "-exact-system-red" : "-exact-secondary-label"
fn days(h: number): string = `${h / 24}d`

component MeatProxy
  state onboarded = false persist
  state defaultFilter = "all" persist
  state openH = 48 persist
  state draftH = 72 persist
  state smart = true persist
  state alerts = true persist
  state filter = "all"
  state query = ""
  state selected = ""
  state gen = 0
  state elapsed = 0
  state banner = ""
  state hovered = ""
  state aimedId = ""
  state aimedUrl = ""
  state aimedRepo = ""
  state ruleName = ""
  state ruleQuery = ""

  resource time = exactTime() as shape Time
  resource session = session() as shape OAuthSession
  derive nowMs = time.epochAtZero + elapsed
  derive onSample = top(nav).name == "sample"
  resource inbox = inbox(gen, filter, query, selected, openH, draftH, smart, onboarded, alerts, onSample) with nowMs when session.signedIn or onSample as shape Inbox else empty(state="checking")
  resource repos = setupRepos(gen, openH, draftH, smart, onboarded, alerts) with nowMs when session.signedIn as shape SetupRepo[] else empty()
  resource rules = rules() as shape RuleRow[] else empty()

  mutation signedIn as shape OAuthResult refreshes session then resync
  mutation signedOut as shape OAuthResult refreshes session
  mutation changed as shape Reply refreshes inbox, repos
  mutation watched as shape Reply refreshes inbox, repos then resync
  mutation moved as shape Reply refreshes inbox, repos then useFixed
  mutation fixed as shape Reply refreshes inbox, repos then useFixed
  mutation snoozed as shape Reply refreshes inbox then snoozedDone
  mutation ruleAdded as shape Reply refreshes rules then ruleAddedDone
  mutation ruleChanged as shape Reply refreshes rules, inbox
  mutation finished as shape Reply then setupDone
  mutation polled as shape Reply then polledDone

  derive linked = session.signedIn and inbox.state == "connected"
  derive aimed = first(inbox.groups.filter(g => g.name == aimedRepo))
  derive aimedWatched = match aimed { case some(g) => g.watched, case none => false }
  derive aimedPinned = match aimed { case some(g) => g.pinned, case none => false }
  derive aimedUp = match aimed { case some(g) => g.canUp, case none => false }
  derive aimedDown = match aimed { case some(g) => g.canDown, case none => false }
  derive signInProblem = match signedIn { case some(r) => r.error, case none => session.error }

  task boot mount
    after(1, start)
  task clock mount
    every(60000, tick)
  task notifications when onboarded and alerts
    every(60000, poll)

  action start
    filter = defaultFilter
    if not onboarded
      nav = go(nav, "/setup")
  action tick
    elapsed = performanceNow()
    if onboarded
      gen = gen + 1
  action poll
    send polled = pollNotifications(alerts)
  action polledDone
    match polled
      case some(r)
        if r.ok
          gen = gen + 1
      case none
        gen = gen
  action resync
    gen = gen + 1
  action follow(url: string)
    nav = go(nav, url)
  action goTo(url: string)
    nav = push(nav, url)
  action goBack
    nav = back(nav)

  // Connect GitHub and set up
  action signIn
    send signedIn = signIn()
  action signOut
    send signedOut = signOut()
  action sample
    nav = push(nav, "/sample")
  action leaveSample
    nav = go(nav, "/setup")
  action finish
    send finished = finishSetup()
  action setupDone
    onboarded = true
    filter = defaultFilter
    banner = ""
    nav = go(nav, "/")
    gen = gen + 1
    if alerts
      showNotification(title="meat-proxy is ready", body="PR reminders will appear here.", tag="setup-complete")

  // The inbox
  action pick(f: string)
    filter = f
  action search(v: string)
    query = v
  action toggleRepo(name: string)
    selected = selected == name ? "" : name
  action open(url: string)
    if not onSample
      openURL(url)
  action hover(id: string, on: bool)
    if on
      hovered = id
    else
      if hovered == id
        hovered = ""
  action aim(id: string, url: string)
    aimedId = id
    aimedUrl = url
  action aimRepo(name: string)
    aimedRepo = name
  action copy(url: string)
    copyText(url)
    banner = "Copied link"
  action snooze(id: string)
    send snoozed = snooze(id, nowMs)
  action snoozedDone
    match snoozed
      case some(r)
        banner = r.message
      case none
        banner = banner
  action dismiss
    banner = ""
  action watch(name: string)
    send watched = toggleRepo(name, "watch")
  action watchSwitch(name: string, on: bool)
    send watched = toggleRepo(name, "watch")
  action pin(name: string)
    send changed = toggleRepo(name, "pin")
  action move(name: string, dir: number, scope: string)
    send moved = moveRepo(name, dir, scope)
  action useFixed
    smart = false
  action order(isSmart: bool)
    if isSmart
      smart = true
    else
      send fixed = fixOrder(nowMs, openH, draftH)
  action opened(tag: string, e: NotificationEvent)
    match e.data
      case some(url)
        openURL(url)
      case none
        banner = banner

  // Settings
  action setDefault(f: string)
    defaultFilter = f
  action setOpen(h: number)
    openH = h
  action setDraft(h: number)
    draftH = h
  action setAlerts(on: bool)
    alerts = on
  action testNotification
    showNotification(title="meat-proxy test", body="PR reminders appear in Notification Center.", tag="test-notification")
  action editRuleName(v: string)
    ruleName = v
  action editRuleQuery(v: string)
    ruleQuery = v
  action addRule
    send ruleAdded = addRule(ruleName, ruleQuery)
  action ruleAddedDone
    match ruleAdded
      case some(r)
        banner = r.message
        if r.ok
          ruleName = ""
          ruleQuery = ""
          gen = gen + 1
      case none
        banner = banner
  action toggleRule(id: string)
    send ruleChanged = toggleRule(id)
  action ruleSwitch(id: string, on: bool)
    send ruleChanged = toggleRule(id)
  action removeRule(id: string)
    send ruleChanged = removeRule(id)
  action openSetup
    nav = go(nav, "/setup")

  view
    main testId="root" navigationKey=`${top(nav).id}` navigate=follow width="100%" height="100%"
      notificationclick=opened
      for e in stack(nav) key=e.id
        if e.name == "setup"
          column navigationKey=`${e.id}` navigationBar="none" position="absolute" inset=0 align-items="center" padding=32
            column max-width="35rem" width="100%" gap=16
              image "assets/setup-icon.png" width=76 height=76 alt=""
              text "Connect GitHub" role="heading" aria-level=1 font="-exact-large-title" testId="setup-title"
              text "Track the pull requests you open and the ones waiting for your review." color="-exact-secondary-label"
              row gap=12 align-items="center" padding="14px 16px" border-radius=8 background-color="-exact-secondary-background"
                image (linked ? "symbol:checkmark" : "symbol:person") width=16 height=16 aria-hidden=true
                text (linked ? `Signed in to GitHub as @${inbox.user}.` : session.signedIn ? "Checking GitHub…" : "Not signed in.") testId="setup-status"
              if signInProblem != ""
                text signInProblem color="-exact-system-red" testId="setup-problem"
              if session.signedIn and inbox.state == "needs-auth"
                text inbox.reason color="-exact-system-red" testId="setup-reason"
              row gap=8
                if linked
                  button press=goTo("/setup/preferences") buttonStyle="filled" testId="onboard-continue"
                    text "Continue"
                  button press=signOut testId="sign-out"
                    text "Sign out"
                else
                  button press=signIn disabled=pending(signedIn) buttonStyle="filled" testId="sign-in"
                    text "Sign in with GitHub"
              if not linked
                button press=sample testId="preview-sample"
                  text "Preview sample inbox"

        if e.name == "prefs"
          column navigationKey=`${e.id}` navigationScroll="prefs-list" position="absolute" inset=0
            header display="flex" align-items="center" gap=8 padding="8px 16px"
              text "Set up your inbox" role="heading" aria-level=1 flex=1
              button press=goBack testId="prefs-back"
                text "Back"
              button press=finish disabled=pending(finished) buttonStyle="filled" testId="confirm-onboarding"
                text "Confirm and open inbox"
            list id="prefs-list" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
              section
                row
                  text "Default inbox" flex=1
                  row role="radiogroup" aria-label="Default inbox"
                    for f in filterIds() key=f
                      button role="radio" aria-checked=(defaultFilter == f) press=setDefault(f) testId=`default-${f}`
                        text filterLabel(f)
                row
                  text "Open PR reminder" flex=1
                  row role="radiogroup" aria-label="Open PR reminder"
                    for h in [24, 48, 72, 120] key=h
                      button role="radio" aria-checked=(openH == h) press=setOpen(h) testId=`open-${h}`
                        text days(h)
                row
                  text "Draft reminder" flex=1
                  row role="radiogroup" aria-label="Draft reminder"
                    for h in [48, 72, 120, 168] key=h
                      button role="radio" aria-checked=(draftH == h) press=setDraft(h) testId=`draft-${h}`
                        text days(h)
                row
                  text "Repository order" flex=1
                  row role="radiogroup" aria-label="Repository order"
                    button role="radio" aria-checked=smart press=order(true) testId="order-smart"
                      text "Smart"
                    button role="radio" aria-checked=(not smart) press=order(false) testId="order-fixed"
                      text "Fixed"
                row
                  text "macOS notifications" flex=1
                  input type="checkbox" switch checked=alerts change=setAlerts aria-label="macOS notifications" testId="alerts"
              section
                header
                  text "Repositories"
                for r in repos key=r.name
                  row testId=`onboard-repo-${r.name}`
                    text r.name flex=1
                    text "Watch open PRs" color="-exact-secondary-label"
                    input type="checkbox" switch checked=r.watched change=watchSwitch(r.name) aria-label=`Watch open PRs in ${r.name}`
                    button press=move(r.name, -1, "setup") disabled=(not r.canUp) aria-label=`Move ${r.name} up`
                      image "symbol:send"
                    button press=move(r.name, 1, "setup") disabled=(not r.canDown) aria-label=`Move ${r.name} down`
                      image "symbol:download"
                footer
                  text (repos.length == 0 ? "No repositories found in your open PRs or review queue." : "Smart order prioritizes PRs that need attention. Watch a repository to include others’ open PRs.")

        if e.name == "home" or e.name == "sample"
          column navigationKey=`${e.id}` navigationScroll="inbox-list" position="absolute" inset=0
            header display="flex" flex-wrap="wrap" align-items="center" gap=8 padding="8px 16px"
              text (onSample ? "Sample inbox" : "Pull requests") role="heading" aria-level=1 flex=1
              text `${inbox.total} open · ${inbox.attention} need attention${inbox.user != "" and not onSample ? ` · @${inbox.user}` : ""}` testId="inbox-summary"
              input type="search" value=query input=search placeholder="Search pull requests" aria-label="Search pull requests" testId="search"
              if onSample
                button press=leaveSample testId="back-to-setup"
                  text "Back to setup"
              else
                button press=resync aria-keyshortcuts="Meta+R" aria-label="Refresh" testId="refresh"
                  image "symbol:refresh"
                link href="/settings" aria-keyshortcuts="Meta+," aria-label="Settings" testId="open-settings"
                  image "symbol:settings"
            list id="inbox-list" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0 testId="inbox"
              section
                row role="radiogroup" aria-label="Filter"
                  for f in filterIds() key=f
                    button role="radio" aria-checked=(filter == f) press=pick(f) testId=`filter-${f}` flex=1
                      text filterLabel(f)
              if banner != ""
                section
                  row
                    text banner flex=1 color="-exact-secondary-label" testId="banner"
                    button press=dismiss testId="dismiss-banner"
                      text "Dismiss"
              if not onSample and inbox.state == "needs-auth"
                section
                  row
                    text `GitHub sync unavailable. ${inbox.reason}` flex=1 testId="sync-problem"
                    button press=openSetup testId="check-github"
                      text "Check GitHub"
              for g in inbox.groups key=g.name
                section testId=`repo-${g.name}`
                  row align-items="center" gap=8 press=toggleRepo(g.name) testId=`repo-name-${g.name}`
                    image "symbol:book" width=15 height=15 color="-exact-secondary-label" aria-hidden=true
                    text g.name font-weight=600 color="-exact-secondary-label"
                    text (selected == g.name ? "(filtered · click to show all)" : `${g.count}`) color="-exact-tertiary-label"
                    view flex=1
                    if not onSample
                      button popovertarget="repo-menu" press=aimRepo(g.name) aria-label=`Actions for ${g.name}` testId=`repo-actions-${g.name}`
                        image "symbol:more"
                  if g.rows.length == 0
                    row
                      text "No open pull requests" color="-exact-secondary-label"
                  for r in g.rows key=r.id
                    row press=open(r.url) hover=hover(r.id) contextmenu=aim(r.id, r.url) contextPopover="row-menu"
                      gap=12 align-items="center" testId=`pr-${r.number}`
                      image (r.depth == 0 ? "symbol:icon.pull-request" : "symbol:icon.stacked") width=16 height=16
                        margin-left=(r.depth * 18) color=(r.draft ? "-exact-tertiary-label" : "-exact-secondary-label") aria-hidden=true
                      column flex=1 min-width=0 gap=4
                        text r.title font-weight=600 white-space="nowrap" overflow="hidden" text-overflow="ellipsis" testId=`title-${r.number}`
                        row gap=8 align-items="center" font="-exact-footnote"
                          text `#${r.number}` color="-exact-secondary-label" font-variant-numeric="tabular-nums"
                          image r.avatar width=16 height=16 border-radius=8 alt=""
                          text (r.mine ? "You" : `@${r.author}`) color=(r.mine ? "-exact-system-purple" : "-exact-secondary-label")
                          text r.age color="-exact-secondary-label"
                          text r.status color=toneColor(r.tone) font-weight=500 testId=`status-${r.number}`
                          if r.parent > 0
                            text `↳ #${r.parent}` color="-exact-secondary-label" title=`Stacked on #${r.parent}`
                          if r.ciFailing
                            text "CI failing" color="-exact-system-red" font-weight=500
                      if r.nudge and not onSample and hovered == r.id
                        button press=copy(r.url) aria-label="Copy PR link" testId=`copy-${r.number}`
                          image "symbol:copy"
                        button press=snooze(r.id) aria-label="Snooze for 24 hours" testId=`snooze-${r.number}`
                          image "symbol:moon"
            if inbox.groups.length == 0 and current(inbox)
              EmptyState(symbol="symbol:checkmark", title="Nothing here.", message="Switch filters or clear your search.")
            column id="row-menu" popover="auto" role="menu"
              button press=open(aimedUrl) popovertarget="row-menu" popovertargetaction="hide" testId="menu-open"
                text "Open on GitHub"
              button press=copy(aimedUrl) popovertarget="row-menu" popovertargetaction="hide" testId="menu-copy"
                text "Copy PR link"
              button press=snooze(aimedId) popovertarget="row-menu" popovertargetaction="hide" testId="menu-snooze"
                text "Snooze for 24 hours"
            column id="repo-menu" popover="auto" role="menu"
              button role="menuitemcheckbox" aria-checked=aimedWatched press=watch(aimedRepo) popovertarget="repo-menu" popovertargetaction="hide" testId="menu-watch"
                text "Watch all open PRs"
              button role="menuitemcheckbox" aria-checked=aimedPinned press=pin(aimedRepo) popovertarget="repo-menu" popovertargetaction="hide" testId="menu-pin"
                text "Pin repository"
              hr
              button press=move(aimedRepo, -1, "inbox") disabled=(not aimedUp) popovertarget="repo-menu" popovertargetaction="hide" testId="menu-up"
                text "Move up"
              button press=move(aimedRepo, 1, "inbox") disabled=(not aimedDown) popovertarget="repo-menu" popovertargetaction="hide" testId="menu-down"
                text "Move down"
              hr
              button role="menuitemcheckbox" aria-checked=smart press=order(not smart) popovertarget="repo-menu" popovertargetaction="hide" testId="menu-smart"
                text "Smart repository order"

        if e.name == "settings"
          column navigationKey=`${e.id}` navigationScroll="settings-list" position="absolute" inset=0
            header display="flex" align-items="center" padding="8px 16px"
              text "Settings" role="heading" aria-level=1 flex=1
            list id="settings-list" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
              section
                row
                  text "Default inbox" flex=1
                  row role="radiogroup" aria-label="Default inbox"
                    for f in filterIds() key=f
                      button role="radio" aria-checked=(defaultFilter == f) press=setDefault(f) testId=`settings-default-${f}`
                        text filterLabel(f)
                row
                  text "macOS notifications" flex=1
                  button press=testNotification disabled=(not alerts) testId="test-notification"
                    text "Send test notification"
                  input type="checkbox" switch checked=alerts change=setAlerts aria-label="macOS notifications" testId="settings-alerts"
              section
                header
                  text "Reminders"
                row
                  text "Nudge my open PRs if unreviewed after" flex=1
                  row role="radiogroup" aria-label="Open PR reminder"
                    for h in [24, 48, 72, 120] key=h
                      button role="radio" aria-checked=(openH == h) press=setOpen(h) testId=`settings-open-${h}`
                        text days(h)
                row
                  text "Nudge my draft PRs if untouched after" flex=1
                  row role="radiogroup" aria-label="Draft PR reminder"
                    for h in [48, 72, 120, 168] key=h
                      button role="radio" aria-checked=(draftH == h) press=setDraft(h) testId=`settings-draft-${h}`
                        text days(h)
                row
                  button press=openSetup testId="rerun-onboarding"
                    text "Open setup"
                  button press=signOut testId="settings-sign-out"
                    text "Sign out of GitHub"
              section
                header
                  text "Subscription rules"
                for r in rules key=r.id
                  row testId=`rule-${r.id}`
                    input type="checkbox" switch checked=r.enabled change=ruleSwitch(r.id) aria-label=`Enable ${r.name}`
                    column flex=1 min-width=0
                      text r.name
                      text r.query font="-exact-footnote" color="-exact-secondary-label"
                    button press=removeRule(r.id) destructive=true testId=`remove-${r.id}`
                      text "Remove"
                row gap=8
                  input value=ruleName input=editRuleName placeholder="Label (e.g. Core PRs)" aria-label="Rule label" testId="rule-name" width="11rem"
                  input value=ruleQuery input=editRuleQuery submit=addRule placeholder="GitHub query (e.g. repo:anomalyco/rune label:core)" aria-label="GitHub query" testId="rule-query" flex=1 min-width=0
                  button press=addRule testId="add-rule"
                    text "Add Rule"
                footer
                  text (banner != "" ? banner : "Rules add others’ open PRs that match a GitHub search.") testId="settings-note"
